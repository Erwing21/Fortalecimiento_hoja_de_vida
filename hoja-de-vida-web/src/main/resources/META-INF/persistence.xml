<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="hojaDeVidaPU" transaction-type="JTA">
        <!-- Datasource creado en WildFly (ver README). La clave vive en el servidor, no en el codigo. -->
        <jta-data-source>java:/jdbc/hojaDeVida</jta-data-source>
        <class>com.estudiante.hojadevida.modelo.Experiencia</class>
        <properties>
            <!-- Muestran en la consola de WildFly el SQL que Hibernate genera -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>